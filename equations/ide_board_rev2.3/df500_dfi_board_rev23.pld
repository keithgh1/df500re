Name     df500_dfi_board_rev23 ;
PartNo   00 ;
Date     7/11/2026 ;
Revision 01 ;
Designer Keith Monahan ;
Company  techtravels.org ;
Assembly None ;
Location  ;
Device   g16v8a;

/****************************************************************************/
/* DataFlyer 500 "DFI" PAL - GAL16V8 replacement for the original 16L8 in   */
/* the BUSS socket of IDE-only (PCB rev 2.3) boards.                        */
/*                                                                          */
/* Not the SCSI-only board's BUSS program (df500_buss_board_rev20/21):      */
/* the two boards carry different original programs in the same socket.     */
/* Shared with BUSS: the AutoConfig latch pair (LE_373/OE_373) and the      */
/* boot-ROM chip select, term-for-term. Different: the read/write strobes   */
/* drive the IDE /DIOR (J8.25) and /DIOW (J8.23) lines and must operate     */
/* in the A15=1 IDE register window, qualified by the SDK window on pin     */
/* 13; there is no 5380 register decode at all.                             */
/*                                                                          */
/* Pin 13: on rev 2.3 boards this is a dedicated two-pin net driven by      */
/* DTACK02 pin 13 - the "SDK" /DACK-window latch (asserts low at the 001    */
/* clock phase of a matched IDE cycle, ~250ns wide). The rev 2.1 KiCad's    */
/* "CCK" label for this pin does not apply to rev 2.3 copper.               */
/*                                                                          */
/* Strobe behavior (bench-verified on the original chip, 2026-07-06/11):    */
/* transparent at A15=0 (ROM/low window); at A15=1 the strobe first         */
/* asserts only while the SDK window is open (pin 13 low), then self-holds  */
/* until the decode ends (AS_MATCH rise or R/W flip) - the window may       */
/* close first. This is what stretches the IDE strobe to ATA PIO width      */
/* while DTACK02 stretches the cycle.                                       */
/*                                                                          */
/* The equations were derived by black-box stimulus/response                */
/* characterization of an original DFI chip (exhaustive sweep in every      */
/* latch state, plus a 212,889-row differential transition campaign). They  */
/* match the original's behavior on every vector tested, with no hidden     */
/* holds found. A GAL16V8 burned from this source matched the original on   */
/* the bench and boots the card together with df500_dtack02_board_rev23.    */
/* NOTE the $48 config decode carries NO !A15 - same as the original SCSI   */
/* BUSS chip.                                                               */
/****************************************************************************/

/* Dedicated input pins */

pin 1   = F32_A1_AND_A2_LOW; /* A1#A2 via 74F32 - low only when A1=A2=0 */
pin 2   = AS_MATCH; /* active low - address comparator match, qualified by /AS */
pin 3   = A3; /* Amiga A3 */
pin 4   = A4; /* Amiga A4 */
pin 5   = A5; /* Amiga A5 */
pin 6   = A6; /* Amiga A6 */
pin 7   = RW; /* 68000 R/W - low = write */
pin 8   = A15; /* low = ROM window, high = IDE register window */
pin 9   = UDS; /* /UDS, active low - upper data byte (ROM/autoconfig lane) */
pin 11  = RESET; /* /RESET, active low */
pin 13  = !SDK_WINDOW; /* /DACK window from DTACK02 pin 13, active low */

/* Programmable output pins (all active low, all always driven -            */
/* bench zsweep: every output totem-pole in both latch states)              */

pin 12  = !ROM_CE; /* boot EPROM /CE */
pin 14  = !LE_373; /* 74LS373 latch enable - captures the assigned base */
pin 15  = !IO_RD; /* IDE /DIOR read strobe (J8.25) */
pin 16  = !IO_WR; /* IDE /DIOW write strobe (J8.23) */
pin 17  = !DACK; /* vestigial: pre-config A15=1 flag, identical to pin 19 */
pin 18  = !OE_373; /* 74LS373 /OE = board "configured" flag */
pin 19  = !SCSI_CS; /* vestigial: same signal as pin 17; no 5380 on board */

/* A = the ec_BaseAddress write: upper-byte write to offset $48 while the   */
/* board is addressed. A1/A2 low (via pin 1) rejects offsets $4A/$4C.       */
/* NO !A15 - bench-proven (same as the original SCSI BUSS chip; A15=1       */
/* cannot occur during a real $E80048 config write anyway).                 */

A = !F32_A1_AND_A2_LOW & !AS_MATCH & A3 & !A4 & !A5 & A6 & !RW & !UDS & RESET;

/* B = OE_373 set condition: base latched and the write cycle has ended.    */

B = LE_373 & AS_MATCH & RESET;

/* The IDE strobes require the board configured (OE_373). At A15=0 they     */
/* are transparent (ROM-window accesses); at A15=1 they arm only inside     */
/* the SDK window and self-hold until AS_MATCH rises or R/W flips. The      */
/* RESET literal is redundant on the bench (RESET clears OE_373) and is     */
/* kept for reset-glitch safety, mirroring the BUSS image.                  */

IO_RD = (!AS_MATCH & RW & OE_373 & RESET & !A15)
      # (!AS_MATCH & RW & OE_373 & RESET & SDK_WINDOW)
      # (IO_RD & !AS_MATCH & RW & OE_373 & RESET);

IO_WR = (!AS_MATCH & !RW & OE_373 & RESET & !A15)
      # (!AS_MATCH & !RW & OE_373 & RESET & SDK_WINDOW)
      # (IO_WR & !AS_MATCH & !RW & OE_373 & RESET);

/* DACK and SCSI_CS carry one identical signal: matched A15=1 access while  */
/* the board is NOT yet configured. Purpose unknown (both pins are          */
/* believed unconnected on the IDE-only board); kept to match the original. */

DACK    = !AS_MATCH & A15 & RESET & !OE_373;
SCSI_CS = !AS_MATCH & A15 & RESET & !OE_373;

LE_373 = (LE_373 & RESET) # A;
OE_373 = (OE_373 & RESET) # B;
ROM_CE = !AS_MATCH & RW & !A15 & !UDS & RESET;
